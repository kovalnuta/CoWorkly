<Window x:Class="CoWorkly.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoWorkly — Вход в систему" 
        Height="450" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#2563EB"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource CardBackground}" 
            CornerRadius="12" 
            Margin="24" 
            Padding="32">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.15"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="🏢 CoWorkly" 
                       FontSize="28" FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,8"/>
            <TextBlock Text="Система бронирования коворкинга" 
                       FontSize="13" Foreground="Gray" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,32"/>

            <TextBlock Text="Выберите пользователя:" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,12"/>

            <ComboBox x:Name="UsersComboBox" 
                      DisplayMemberPath="Username" 
                      Height="40" 
                      FontSize="14"
                      Margin="0,0,0,16"/>

            <TextBlock Text="Или войдите как гость (тест):" 
                       FontSize="12" Foreground="Gray" 
                       Margin="0,0,0,8"/>

            <Button Content="👤 Войти как Анна (Админ)" 
                    Click="LoginAsAdmin_Click" 
                    Margin="0,0,0,8"/>

            <Button Content="👤 Войти как Кирилл (Клиент)" 
                    Click="LoginAsClient_Click" 
                    Margin="0,0,0,24"
                    Background="#10B981"/>

            <TextBlock x:Name="ErrorMessage" 
                       Text="" 
                       Foreground="Red" 
                       FontSize="12" 
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>