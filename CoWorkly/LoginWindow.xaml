<Window x:Class="CoWorkly.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoWorkly — Вход в систему"
        Height="720" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="#FAF7F2"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor"   Color="#A8C5DA"/>
        <SolidColorBrush x:Key="AccentColor"    Color="#B8D8C8"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PageBackground" Color="#FAF7F2"/>
        <SolidColorBrush x:Key="TextPrimary"    Color="#4A5568"/>
        <SolidColorBrush x:Key="TextSecondary"  Color="#8A94A6"/>
        <SolidColorBrush x:Key="BorderSoft"     Color="#E5E1DA"/>
        <SolidColorBrush x:Key="ErrorColor"     Color="#D9534F"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для маленькой кнопки-иконки глаза -->
        <Style x:Key="EyeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#8A94A6"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EEF4F8"/>
                                <Setter Property="Foreground" Value="#4A5568"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldErrorStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ErrorColor}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#FDFCFB"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#FDFCFB"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                Padding="16,8"
                                Margin="0,0,8,0"
                                CornerRadius="8">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF4F8"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F4F0EA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageBackground}">
        <Border Background="{StaticResource CardBackground}"
                CornerRadius="16"
                Margin="28"
                Padding="36,28">
            <Border.Effect>
                <DropShadowEffect Color="#8A94A6" Direction="270"
                                  ShadowDepth="2" BlurRadius="18" Opacity="0.18"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CoWorkly"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Система бронирования коворкинга"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,22"/>

                    <TabControl x:Name="AuthTabs"
                                Background="Transparent"
                                BorderThickness="0">
                        <!-- ВКЛАДКА ВХОДА -->
                        <TabItem Header="Вход">
                            <StackPanel Margin="0,18,0,0">
                                <TextBlock Text="Имя пользователя"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="0,0,0,6"/>
                                <TextBox x:Name="LoginUsernameBox"/>
                                <TextBlock x:Name="LoginUsernameError" Style="{StaticResource FieldErrorStyle}"/>

                                <TextBlock Text="Пароль"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="0,6,0,6"/>
                                <Grid>
                                    <PasswordBox x:Name="LoginPasswordBox" Padding="10,0,40,0"/>
                                    <TextBox x:Name="LoginPasswordVisible" Padding="10,0,40,0" Visibility="Collapsed"/>
                                    <Button x:Name="LoginPasswordToggle"
                                            Style="{StaticResource EyeButtonStyle}"
                                            Content="&#xE7B3;"
                                            ToolTip="Показать пароль"
                                            Click="ToggleLoginPassword_Click"/>
                                </Grid>
                                <TextBlock x:Name="LoginPasswordError" Style="{StaticResource FieldErrorStyle}"/>

                                <Button Content="Войти" Click="Login_Click" Margin="0,14,0,12"/>

                                <TextBlock x:Name="LoginError"
                                           Text=""
                                           Foreground="{StaticResource ErrorColor}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </TabItem>

                        <!-- ВКЛАДКА РЕГИСТРАЦИИ -->
                        <TabItem Header="Регистрация">
                            <StackPanel Margin="0,18,0,0">
                                <TextBlock Text="Имя пользователя"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="0,0,0,6"/>
                                <TextBox x:Name="RegUsernameBox"/>
                                <TextBlock x:Name="RegUsernameError" Style="{StaticResource FieldErrorStyle}"/>

                                <TextBlock Text="Email"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="0,6,0,6"/>
                                <TextBox x:Name="RegEmailBox"/>
                                <TextBlock x:Name="RegEmailError" Style="{StaticResource FieldErrorStyle}"/>

                                <TextBlock Text="Пароль"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="0,6,0,6"/>
                                <Grid>
                                    <PasswordBox x:Name="RegPasswordBox" Padding="10,0,40,0"/>
                                    <TextBox x:Name="RegPasswordVisible" Padding="10,0,40,0" Visibility="Collapsed"/>
                                    <Button x:Name="RegPasswordToggle"
                                            Style="{StaticResource EyeButtonStyle}"
                                            Content="&#xE7B3;"
                                            ToolTip="Показать пароль"
                                            Click="ToggleRegPassword_Click"/>
                                </Grid>
                                <TextBlock x:Name="RegPasswordError" Style="{StaticResource FieldErrorStyle}"/>

                                <TextBlock Text="Повторите пароль"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="0,6,0,6"/>
                                <Grid>
                                    <PasswordBox x:Name="RegConfirmBox" Padding="10,0,40,0"/>
                                    <TextBox x:Name="RegConfirmVisible" Padding="10,0,40,0" Visibility="Collapsed"/>
                                    <Button x:Name="RegConfirmToggle"
                                            Style="{StaticResource EyeButtonStyle}"
                                            Content="&#xE7B3;"
                                            ToolTip="Показать пароль"
                                            Click="ToggleRegConfirm_Click"/>
                                </Grid>
                                <TextBlock x:Name="RegConfirmError" Style="{StaticResource FieldErrorStyle}"/>

                                <Button Content="Зарегистрироваться"
                                        Click="Register_Click"
                                        Background="{StaticResource AccentColor}"
                                        Margin="0,14,0,12"/>

                                <TextBlock x:Name="RegError"
                                           Text=""
                                           Foreground="{StaticResource ErrorColor}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                    <TextBlock Text="Тестовые аккаунты: Anna / Passw0rd!, Kirill / Passw0rd!"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,22,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>