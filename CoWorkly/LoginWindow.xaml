<Window
    x:Class="CoWorkly.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    Title="CoWorkly"
    Width="440"
    Height="740"
    MinWidth="420"
    MinHeight="680"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    ResizeMode="CanResizeWithGrip"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">


    <!--  Появление окнаь проявление подъём на 16 px  -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation
                        Storyboard.TargetName="Root"
                        Storyboard.TargetProperty="Opacity"
                        From="0"
                        To="1"
                        Duration="0:0:0.22" />
                    <DoubleAnimation
                        Storyboard.TargetName="RootTranslate"
                        Storyboard.TargetProperty="Y"
                        From="16"
                        To="0"
                        Duration="0:0:0.42">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>


    <Border
        x:Name="Root"
        Background="{DynamicResource RegionBrush}"
        CornerRadius="12"
        RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" Y="0" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="42"
                Opacity="0.18"
                ShadowDepth="0"
                Color="{StaticResource ShadowColor}" />
        </Border.Effect>
        <Border.Clip>
            <RectangleGeometry
                RadiusX="12"
                RadiusY="12"
                Rect="0,0,10000,10000" />
        </Border.Clip>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Заголовок окна  -->
            <Grid
                Grid.Row="0"
                Height="40"
                Background="Transparent"
                MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Width="18"
                        Height="18"
                        Background="{DynamicResource PrimaryBrush}"
                        CornerRadius="5">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="C" />
                    </Border>
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="CoWorkly" />
                </StackPanel>

                <StackPanel
                    Margin="0,5,6,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
                    <Button
                        Click="Minimize_Click"
                        Content="&#xE921;"
                        Style="{StaticResource ChromeButton}"
                        ToolTip="Свернуть" />
                    <Button
                        Click="Maximize_Click"
                        Content="&#xE922;"
                        Style="{StaticResource ChromeButton}"
                        ToolTip="Развернуть" />
                    <Button
                        Click="Close_Click"
                        Content="&#xE8BB;"
                        Style="{StaticResource CloseChromeButton}"
                        ToolTip="Закрыть" />
                </StackPanel>
            </Grid>

            <!--  Содержимое  -->
            <ScrollViewer
                Grid.Row="1"
                Padding="44,12,44,36"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="380">

                    <!--  Заголовок  -->
                    <TextBlock
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="Вход в аккаунт" />
                    <TextBlock
                        Margin="0,6,0,28"
                        FontSize="13"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="Рабочее пространство CoWorkly" />

                    <!--  белая плашка ездит под активной кнопкой  -->
                    <Border
                        Height="42"
                        Margin="0,0,0,26"
                        Padding="4"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        CornerRadius="11">
                        <Grid x:Name="TabsHost">
                            <Border
                                x:Name="TabIndicator"
                                Width="180"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource RegionBrush}"
                                CornerRadius="8">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="IndicatorTranslate" X="0" />
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="6"
                                        Opacity="0.10"
                                        ShadowDepth="1"
                                        Color="{StaticResource ShadowColor}" />
                                </Border.Effect>
                            </Border>

                            <UniformGrid Columns="2">
                                <Button
                                    x:Name="LoginTabBtn"
                                    Click="LoginTab_Click"
                                    Content="Вход"
                                    Style="{StaticResource SegmentButton}"
                                    Tag="Active" />
                                <Button
                                    x:Name="RegTabBtn"
                                    Click="RegTab_Click"
                                    Content="Регистрация"
                                    Style="{StaticResource SegmentButton}" />
                            </UniformGrid>
                        </Grid>
                    </Border>


                    <Grid>
                        <!--  ВХОД  -->
                        <StackPanel x:Name="LoginPanel">
                            <hc:TextBox
                                x:Name="LoginUsernameBox"
                                Padding="12,10"
                                hc:InfoElement.Placeholder="anna"
                                hc:InfoElement.Title="Имя пользователя"
                                hc:InfoElement.TitlePlacement="Top"
                                FontSize="14" />
                            <TextBlock x:Name="LoginUsernameError" Style="{StaticResource FieldError}" />

                            <hc:PasswordBox
                                x:Name="LoginPasswordBox"
                                Margin="0,16,0,0"
                                Padding="12,10"
                                hc:InfoElement.Placeholder="••••••••"
                                hc:InfoElement.Title="Пароль"
                                hc:InfoElement.TitlePlacement="Top"
                                FontSize="14"
                                ShowEyeButton="True" />
                            <TextBlock x:Name="LoginPasswordError" Style="{StaticResource FieldError}" />

                            <Button
                                Margin="0,26,0,10"
                                Click="Login_Click"
                                Content="Продолжить"
                                IsDefault="True"
                                Style="{StaticResource PrimaryButton}" />

                            <TextBlock
                                x:Name="LoginError"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource DangerBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!--  РЕГИСТРАЦИЯ  -->
                        <StackPanel x:Name="RegPanel" Visibility="Collapsed">
                            <hc:TextBox
                                x:Name="RegUsernameBox"
                                Padding="12,10"
                                hc:InfoElement.Placeholder="Ваше имя"
                                hc:InfoElement.Title="Имя пользователя"
                                hc:InfoElement.TitlePlacement="Top"
                                FontSize="14" />
                            <TextBlock x:Name="RegUsernameError" Style="{StaticResource FieldError}" />

                            <hc:TextBox
                                x:Name="RegEmailBox"
                                Margin="0,16,0,0"
                                Padding="12,10"
                                hc:InfoElement.Placeholder="you@example.com"
                                hc:InfoElement.Title="Электронная почта"
                                hc:InfoElement.TitlePlacement="Top"
                                FontSize="14" />
                            <TextBlock x:Name="RegEmailError" Style="{StaticResource FieldError}" />

                            <hc:PasswordBox
                                x:Name="RegPasswordBox"
                                Margin="0,16,0,0"
                                Padding="12,10"
                                hc:InfoElement.Placeholder="Минимум 8 символов"
                                hc:InfoElement.Title="Пароль"
                                hc:InfoElement.TitlePlacement="Top"
                                FontSize="14"
                                ShowEyeButton="True" />
                            <TextBlock x:Name="RegPasswordError" Style="{StaticResource FieldError}" />

                            <hc:PasswordBox
                                x:Name="RegConfirmBox"
                                Margin="0,16,0,0"
                                Padding="12,10"
                                hc:InfoElement.Placeholder="Повторите пароль"
                                hc:InfoElement.Title="Подтверждение пароля"
                                hc:InfoElement.TitlePlacement="Top"
                                FontSize="14"
                                ShowEyeButton="True" />
                            <TextBlock x:Name="RegConfirmError" Style="{StaticResource FieldError}" />

                            <Button
                                Margin="0,26,0,10"
                                Click="Register_Click"
                                Content="Создать аккаунт"
                                Style="{StaticResource PrimaryButton}" />

                            <TextBlock
                                x:Name="RegError"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource DangerBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!--  Подсказка с тестовыми аккаунтами  -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="11.5"
                        Foreground="{DynamicResource ThirdlyTextBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap">
                        <Run Text="ТЕСТ:" />
                        <Run
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Text=" Anna" />
                        <Run Foreground="{DynamicResource SecondaryTextBrush}" Text=" Passw0rd!" />
                        <Run Text="  ·  " />
                        <Run
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Text="Kirill" />
                        <Run Foreground="{DynamicResource SecondaryTextBrush}" Text=" Passw0rd!" />
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
