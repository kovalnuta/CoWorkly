<Window x:Class="CoWorkly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoWorkly — Интерактивная карта коворкинга" 
        Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#2563EB"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryColor}">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏢" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="CoWorkly" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentUserName}" 
                               Foreground="White" FontSize="14" 
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="🔧 Тестовые данные" 
                            Command="{Binding CreateTestDataCommand}" 
                            Background="#10B981" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="Выйти" 
                            Click="Logout_Click" 
                            Background="#1E40AF" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ХЛЕБНЫЕ КРОШКИ + КНОПКА НАЗАД -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="24,12">
            <DockPanel>
                <Button Content="← Назад" 
                        Command="{Binding GoBackCommand}" 
                        Padding="12,6" 
                        Margin="0,0,16,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentLevel}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="{Binding Breadcrumb}" 
                           FontSize="16" FontWeight="SemiBold" 
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ОСНОВНОЙ КОНТЕНТ -->
        <Grid Grid.Row="2" Margin="24">

            <!-- УРОВЕНЬ 1: ЭТАЖИ -->
            <ItemsControl ItemsSource="{Binding Floors}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentLevel}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectFloorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Height="200" Margin="12" Background="#2563EB">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🏢" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Number, StringFormat='Этаж {0}'}" 
                                           FontSize="28" FontWeight="Bold" 
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding Description}" 
                                           FontSize="13" Opacity="0.9" 
                                           HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- УРОВЕНЬ 2: КОМНАТЫ -->
            <ItemsControl ItemsSource="{Binding Rooms}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentLevel}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectRoomCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Width="260" Height="140" Margin="8" Background="#3B82F6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🚪" FontSize="36" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" 
                                           FontSize="16" FontWeight="Bold" 
                                           HorizontalAlignment="Center" Margin="0,8,0,0"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="{Binding Capacity, StringFormat='Вместимость: {0} чел.'}" 
                                           FontSize="12" Opacity="0.9" 
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- УРОВЕНЬ 3: МЕСТА В КОМНАТЕ -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentLevel}" Value="3">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Легенда -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="24" Height="24" CornerRadius="4" Background="#E5E7EB" Margin="0,0,8,0"/>
                            <TextBlock Text="Свободно" VerticalAlignment="Center" Margin="0,0,20,0"/>

                            <Border Width="24" Height="24" CornerRadius="4" Background="#3B82F6" Margin="0,0,8,0"/>
                            <TextBlock Text="Моя бронь" VerticalAlignment="Center" Margin="0,0,20,0"/>

                            <Border Width="24" Height="24" CornerRadius="4" Background="#EF4444" Margin="0,0,8,0"/>
                            <TextBlock Text="Занято" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Сетка мест (как в кинотеатре) -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="24">
                        <ItemsControl ItemsSource="{Binding Seats}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding DataContext.MaxColumn, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                 Rows="{Binding DataContext.MaxRow, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectSeatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="{Binding StatusColor}"
                                            Foreground="{Binding TextColor}"
                                            Width="60" Height="50"
                                            Margin="4"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Content="{Binding DisplayText}"
                                            ToolTip="{Binding Tooltip}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="6"
                                                        BorderBrush="#D1D5DB"
                                                        BorderThickness="1">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ПОДВАЛ -->
        <Border Grid.Row="3" Background="#E5E7EB" BorderThickness="0,1,0,0" BorderBrush="#D1D5DB">
            <TextBlock Text="{Binding StatusMessage}" 
                       VerticalAlignment="Center" Margin="24,0" 
                       FontSize="13" Foreground="#6B7280" FontStyle="Italic"/>
        </Border>
    </Grid>
</Window>