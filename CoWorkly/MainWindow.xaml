<Window
    x:Class="CoWorkly.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CoWorkly"
    Width="1120"
    Height="760"
    MinWidth="900"
    MinHeight="620"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    ResizeMode="CanResize"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <!--  Растягивание окна за любой край и угол (рамка 6 px)  -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!--  Появление окна: проявление и подъём на 16 px (как у LoginWindow)  -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation
                        Storyboard.TargetName="Root"
                        Storyboard.TargetProperty="Opacity"
                        From="0"
                        To="1"
                        Duration="0:0:0.22" />
                    <DoubleAnimation
                        Storyboard.TargetName="RootTranslate"
                        Storyboard.TargetProperty="Y"
                        From="16"
                        To="0"
                        Duration="0:0:0.42">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border
        x:Name="Root"
        Background="{DynamicResource RegionBrush}"
        CornerRadius="12"
        RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" Y="0" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="42"
                Opacity="0.18"
                ShadowDepth="0"
                Color="{StaticResource ShadowColor}" />
        </Border.Effect>
        <Border.Clip>
            <RectangleGeometry
                RadiusX="12"
                RadiusY="12"
                Rect="0,0,10000,10000" />
        </Border.Clip>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="155*"/>
                <ColumnDefinition Width="966*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Заголовок окна  -->
            <Grid
                Grid.Row="0"
                Height="40"
                Background="Transparent"
                MouseLeftButtonDown="TitleBar_MouseDown" Grid.ColumnSpan="2">
                <StackPanel
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Width="18"
                        Height="18"
                        Background="{DynamicResource PrimaryBrush}"
                        CornerRadius="5">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="C" />
                    </Border>
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="CoWorkly" />
                </StackPanel>

                <StackPanel
                    Margin="0,5,6,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">

                    <!--  Пользователь и выход  -->
                    <Border
                        Height="28"
                        Margin="0,1,8,0"
                        Padding="10,0"
                        VerticalAlignment="Top"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        CornerRadius="8">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Border
                                Width="18"
                                Height="18"
                                Background="{DynamicResource LightPrimaryBrush}"
                                CornerRadius="9">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Text="👤" />
                            </Border>
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Text="{Binding CurrentUserName}" />
                        </StackPanel>
                    </Border>
                    <Button
                        Margin="0,1,10,0"
                        VerticalAlignment="Top"
                        Click="Logout_Click"
                        Content="Выйти"
                        Style="{StaticResource GhostButton}"
                        ToolTip="Выйти из аккаунта" />

                    <Button
                        Click="Minimize_Click"
                        Content="&#xE921;"
                        Style="{StaticResource ChromeButton}"
                        ToolTip="Свернуть" />
                    <Button
                        Click="Maximize_Click"
                        Content="&#xE922;"
                        Style="{StaticResource ChromeButton}"
                        ToolTip="Развернуть" />
                    <Button
                        Click="Close_Click"
                        Content="&#xE8BB;"
                        Style="{StaticResource CloseChromeButton}"
                        ToolTip="Закрыть" />
                </StackPanel>
            </Grid>

            <!--  Заголовок страницы: назад, путь, обновить  -->
            <DockPanel Grid.Row="1" Margin="44,12,44,24" Grid.ColumnSpan="2">
                <Button
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    Command="{Binding GoBackCommand}"
                    Content="← Назад"
                    DockPanel.Dock="Left">
                    <Button.Style>
                        <Style BasedOn="{StaticResource GhostButton}" TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentLevel}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!--  Обновить — только на уровне мест (FR-06)  -->
                <Button
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}"
                    Content="⟳  Обновить"
                    DockPanel.Dock="Right"
                    ToolTip="Перечитать занятость мест">
                    <Button.Style>
                        <Style BasedOn="{StaticResource GhostButton}" TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentLevel}" Value="3">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="{Binding Breadcrumb}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="Выберите этаж, комнату и место" />
                </StackPanel>
            </DockPanel>

            <!--  Содержимое  -->
            <ScrollViewer
                Grid.Row="2"
                Padding="44,0,44,16"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="2">
                <Grid>

                    <!--  УРОВЕНЬ 1: ЭТАЖИ  -->
                    <ItemsControl Margin="0,0,-16,0" ItemsSource="{Binding Floors}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentLevel}" Value="1">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Height="200"
                                    Margin="0,0,16,16"
                                    Command="{Binding DataContext.SelectFloorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource CardButton}">
                                    <StackPanel>
                                        <Border
                                            Width="40"
                                            Height="40"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource LightPrimaryBrush}"
                                            CornerRadius="10">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="18"
                                                Text="🏢" />
                                        </Border>
                                        <TextBlock
                                            Margin="0,18,0,0"
                                            FontSize="22"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                            Text="{Binding Number, StringFormat='Этаж {0}'}" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="13"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            Text="{Binding Description}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  УРОВЕНЬ 2: КОМНАТЫ  -->
                    <ItemsControl Margin="0,0,-16,0" ItemsSource="{Binding Rooms}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentLevel}" Value="2">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Height="132"
                                    Margin="0,0,16,16"
                                    Command="{Binding DataContext.SelectRoomCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource CardButton}">
                                    <DockPanel>
                                        <Border
                                            Width="40"
                                            Height="40"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource SecondaryRegionBrush}"
                                            CornerRadius="10"
                                            DockPanel.Dock="Left">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="18"
                                                Text="🚪" />
                                        </Border>
                                        <StackPanel Margin="14,0,0,0">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource PrimaryTextBrush}"
                                                Text="{Binding Name}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                FontSize="12.5"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Text="{Binding Capacity, StringFormat='Вместимость: {0} чел.'}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  УРОВЕНЬ 3: МЕСТА  -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentLevel}" Value="3">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!--  Легенда  -->
                        <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                            <Border Background="{DynamicResource SeatFreeBrush}" Style="{StaticResource LegendDot}" />
                            <TextBlock Style="{StaticResource LegendText}" Text="Свободно" />
                            <Border Background="{DynamicResource SeatMineBrush}" Style="{StaticResource LegendDot}" />
                            <TextBlock Style="{StaticResource LegendText}" Text="Моя бронь" />
                            <Border Background="{DynamicResource SeatBusyBrush}" Style="{StaticResource LegendDot}" />
                            <TextBlock Style="{StaticResource LegendText}" Text="Занято" />
                        </StackPanel>

                        <!--  Сетка мест  -->
                        <Border
                            Padding="24"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource RegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <ItemsControl ItemsSource="{Binding Seats}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding DataContext.MaxColumn, RelativeSource={RelativeSource AncestorType=Window}}" Rows="{Binding DataContext.MaxRow, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Command="{Binding DataContext.SelectSeatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding DisplayText}"
                                            Style="{StaticResource SeatButton}"
                                            ToolTip="{Binding Tooltip}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!--  Статусная строка  -->
            <Border
                Grid.Row="2"
                Padding="44,10"
                Background="{DynamicResource SecondaryRegionBrush}" Grid.ColumnSpan="2" Margin="0,591,0,0" Grid.RowSpan="2">
                <DockPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        FontSize="11.5"
                        Foreground="{DynamicResource ThirdlyTextBrush}"
                        Text="{Binding AppVersion}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="{Binding StatusMessage}"
                        TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
