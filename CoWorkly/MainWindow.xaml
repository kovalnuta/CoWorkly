<Window x:Class="CoWorkly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoWorkly — Интерактивная карта коворкинга"
        Height="760" Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="#FAF7F2">

    <Window.Resources>
        <!-- ПАСТЕЛЬНАЯ ПАЛИТРА -->
        <SolidColorBrush x:Key="PrimaryColor"   Color="#A8C5DA"/>
        <SolidColorBrush x:Key="PrimarySoft"    Color="#EEF4F8"/>
        <SolidColorBrush x:Key="AccentColor"    Color="#B8D8C8"/>
        <SolidColorBrush x:Key="AccentSoft"     Color="#EAF5EF"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PageBackground" Color="#FAF7F2"/>
        <SolidColorBrush x:Key="TextPrimary"    Color="#4A5568"/>
        <SolidColorBrush x:Key="TextSecondary"  Color="#8A94A6"/>
        <SolidColorBrush x:Key="BorderSoft"     Color="#E5E1DA"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryColor}">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏢" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="CoWorkly" FontSize="22" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentUserName}"
                               Foreground="White" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="Выйти"
                            Click="Logout_Click"
                            Background="#94B4C9"
                            Padding="14,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ХЛЕБНЫЕ КРОШКИ + КНОПКА НАЗАД -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBackground}"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <DockPanel>
                <Button Content="← Назад"
                        Command="{Binding GoBackCommand}"
                        Background="{StaticResource PrimarySoft}"
                        Foreground="{StaticResource PrimaryColor}"
                        Padding="12,6"
                        Margin="0,0,16,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentLevel}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="{Binding Breadcrumb}"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ОСНОВНОЙ КОНТЕНТ -->
        <Grid Grid.Row="2" Margin="24">

            <!-- УРОВЕНЬ 1: ЭТАЖИ -->
            <ItemsControl ItemsSource="{Binding Floors}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentLevel}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectFloorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Height="220" Margin="12"
                                Background="{StaticResource PrimaryColor}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🏢" FontSize="46" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Number, StringFormat='Этаж {0}'}"
                                           FontSize="26" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding Description}"
                                           FontSize="13" Opacity="0.95"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="8,4,8,0"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- УРОВЕНЬ 2: КОМНАТЫ -->
            <ItemsControl ItemsSource="{Binding Rooms}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentLevel}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectRoomCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Width="270" Height="150" Margin="8"
                                Background="{StaticResource AccentColor}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🚪" FontSize="34" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="15" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="{Binding Capacity, StringFormat='Вместимость: {0} чел.'}"
                                           FontSize="12" Opacity="0.95"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- УРОВЕНЬ 3: МЕСТА В КОМНАТЕ -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentLevel}" Value="3">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Легенда -->
                    <Border Grid.Row="0"
                            Background="{StaticResource CardBackground}"
                            CornerRadius="10"
                            Padding="18"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="6"
                                    Background="#EDEAE4"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    Margin="0,0,8,0"/>
                            <TextBlock Text="Свободно" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0,0,22,0"/>

                            <Border Width="22" Height="22" CornerRadius="6"
                                    Background="#A8C5DA"
                                    Margin="0,0,8,0"/>
                            <TextBlock Text="Моя бронь" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0,0,22,0"/>

                            <Border Width="22" Height="22" CornerRadius="6"
                                    Background="#E8B4B4"
                                    Margin="0,0,8,0"/>
                            <TextBlock Text="Занято" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                    </Border>

                    <!-- Сетка мест -->
                    <Border Grid.Row="1"
                            Background="{StaticResource CardBackground}"
                            CornerRadius="10"
                            Padding="26">
                        <ItemsControl ItemsSource="{Binding Seats}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding DataContext.MaxColumn, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Rows="{Binding DataContext.MaxRow, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectSeatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="{Binding StatusColor}"
                                            Foreground="{Binding TextColor}"
                                            Width="62" Height="52"
                                            Margin="4"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Content="{Binding DisplayText}"
                                            ToolTip="{Binding Tooltip}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="8"
                                                        BorderBrush="#DED9D1"
                                                        BorderThickness="1">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ПОДВАЛ -->
        <Border Grid.Row="3"
                Background="#F1EDE7"
                BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource BorderSoft}">
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center" Margin="24,0"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondary}"
                       FontStyle="Italic"/>
        </Border>
    </Grid>
</Window>