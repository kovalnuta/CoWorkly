<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Палитра расскраски
        
        1)  ключи HandyControl
        
        2) своих цветов
    -->

    <!--  Ключи HandyControl  -->

    <!--  Внимательность  -->
    <Color x:Key="PrimaryColor">#5B8A72</Color>
    <Color x:Key="DarkPrimaryColor">#4C7862</Color>
    <Color x:Key="LightPrimaryColor">#EAF1ED</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#5B8A72" />
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="#4C7862" />
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="#EAF1ED" />

    <!--  Ошибки  -->
    <Color x:Key="DangerColor">#C9544E</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="#C9544E" />

    <!--  Буковы  -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1E2420" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6A7370" />
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="#9AA29E" />

    <!--  Фон и рамки  -->
    <SolidColorBrush x:Key="RegionBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="#F3F2EE" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E7E5DF" />

    <!--  Свои цвета  -->

    <!--  основная кнопка  -->
    <Color x:Key="PressPrimaryColor">#3F6754</Color>
    <SolidColorBrush x:Key="PressPrimaryBrush" Color="#3F6754" />

    <!--  плашки вкладок  -->
    <Color x:Key="ShadowColor">#1E2420</Color>

    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#11000000" />

    <!--  Статусы мест (FR-06)  для главного окна  -->
    <SolidColorBrush x:Key="SeatFreeBrush" Color="#EDEAE4" />
    <SolidColorBrush x:Key="SeatMineBrush" Color="#A8C5DA" />
    <SolidColorBrush x:Key="SeatBusyBrush" Color="#E8B4B4" />

</ResourceDictionary>
